# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY=MY_GEMINI_API_KEY

# Secure backend endpoint for AI Study processing
BACKEND_API_URL=https://api.studynotes.ai/v1/

# Server-side placeholder (Note: Never exposed in client code)
OPENAI_API_KEY=sk-proj-placeholder-server-side-key

